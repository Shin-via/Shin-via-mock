{
  "info": {
    "name": "Shinvia Mock - MyData Card APIs",
    "description": "카드-001/002/004/005 연계 호출용 컬렉션. 001 결과의 card_id와 004 결과의 charge_month, seqno를 자동으로 저장합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:9090" },
    { "key": "access_token", "value": "" },
    { "key": "org_code", "value": "004" },
    { "key": "card_id", "value": "" },
    { "key": "charge_month", "value": "202607" },
    { "key": "seqno", "value": "0" }
  ],
  "item": [
    {
      "name": "카드-001 카드 목록",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_url}}/v2/card/cards?org_code={{org_code}}&search_timestamp=20260810111500&limit=10"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('필수 카드 목록 필드', () => { pm.expect(body).to.have.property('rsp_code'); pm.expect(body).to.have.property('card_list'); });",
        "if (body.card_list && body.card_list.length) pm.collectionVariables.set('card_id', body.card_list[0].card_id);"
      ] } }]
    },
    {
      "name": "카드-002 카드 기본정보",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_url}}/v2/card/cards/{{card_id}}?org_code={{org_code}}&search_timestamp=20260810111500"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('필수 기본정보 필드', () => { const b = pm.response.json(); ['is_trans_payable','is_cash_card','card_brand','annual_fee','issue_date'].forEach(k => pm.expect(b).to.have.property(k)); });"
      ] } }]
    },
    {
      "name": "카드-004 청구 기본정보",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_url}}/v2/card/bills?org_code={{org_code}}&from_month=202605&to_month=202607&limit=10"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('필수 청구 필드', () => { pm.expect(body).to.have.property('bill_list'); });",
        "if (body.bill_list && body.bill_list.length) { pm.collectionVariables.set('charge_month', body.bill_list[0].charge_month); pm.collectionVariables.set('seqno', body.bill_list[0].seqno || ''); }"
      ] } }]
    },
    {
      "name": "카드-005 청구 상세정보",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_url}}/v2/card/bills/detail?org_code={{org_code}}&seqno={{seqno}}&charge_month={{charge_month}}&limit=10"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('필수 상세 필드', () => { const b = pm.response.json(); pm.expect(b).to.have.property('bill_detail_list'); });"
      ] } }]
    }
  ]
}
